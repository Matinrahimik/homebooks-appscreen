{
  "name": "yuzu.shot",
  "version": "1.0.0",
  "description": "App Store Screenshot Generator - Create beautiful App Store marketing screenshots",
  "author": {
    "name": "YUZUHub",
    "email": "hello@yuzuhub.com",
    "url": "https://yuzuhub.com"
  },
  "license": "MIT",
  "homepage": "https://yuzu-hub.github.io/appscreen/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YUZU-Hub/appscreen"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "start": "node --experimental-strip-types local/server.ts",
    "import": "node --experimental-strip-types local/import-cli.ts",
    "postinstall": "playwright install chromium",
    "test:local": "node --experimental-strip-types --test test/pages-artifact.test.mjs test/local-server.test.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
